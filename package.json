{
  "name": "tunnelweb",
  "version": "0.1.1",
  "description": "A Frutiger Aero messenger in your browser: chat, chatrooms, files and group calls, peer-to-peer with one npx command.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/drmikesamy/TunnelWeb.git"
  },
  "bin": {
    "tunnelweb": "server/cli.js"
  },
  "files": [
    "dist",
    "server"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "vite",
    "dev:host": "node server/cli.js --local --no-open",
    "build": "vite build",
    "check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json",
    "start": "npm run build && node server/cli.js",
    "prepack": "npm run build"
  },
  "dependencies": {
    "open": "^11.0.4",
    "p2p-tunnel": "^0.1.14",
    "sirv": "^3.0.2",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@fontsource/comic-neue": "^5.3.0",
    "@fontsource/lobster": "^5.3.0",
    "@fontsource/pacifico": "^5.3.0",
    "@fontsource/roboto": "^5.3.0",
    "@fontsource/source-code-pro": "^5.3.1",
    "@lucide/svelte": "^1.73.0",
    "@neodrag/svelte": "^2.3.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^24.19.2",
    "emoji-picker-element": "^1.29.1",
    "emoji-picker-element-data": "^1.8.0",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.7",
    "svelte-sonner": "^1.2.3",
    "typescript": "~6.0.3",
    "vite": "^8.3.6"
  }
}
